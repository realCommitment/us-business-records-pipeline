  "cards": [
    {
      "dot": "emerald",
      "title": "Extract, untouched",
      "items": [
        "Every file is stored exactly as published, with a .meta.json sidecar",
        "HEAD validators, a SHA-256, a one-byte ranged GET or SFTP size and mtime decide 'unchanged'",
        "Every write goes to .part and then os.replace, so a crash never leaves half a file"
      ]
    },
    {
      "dot": "cyan",
      "title": "Merge, never guess",
      "items": [
        "A record joins a business only when exactly one candidate fits",
        "Tiers: name + ZIP5, name + city, Jaro-Winkler 0.92 at the same street number, trade name, then plan sponsors",
        "Links only point at anchors, so one bad link cannot chain two businesses together"
      ]
    },
    {
      "dot": "violet",
      "title": "One output",
      "items": [
        "Industry, years in business, Google Maps lookup details and open status for every row",
        "Unchanged input gives a byte-identical file, with the same SHA-256 on every run",
        "No business filtering: every cut belongs to the consumer"
      ]
    }
  ]

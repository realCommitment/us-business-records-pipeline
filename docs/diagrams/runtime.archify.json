      "dot": "emerald",
      "title": "Pipeline code",
      "items": [
        "include/ never imports Airflow, enforced by a Ruff banned-API rule",
        "Every transform runs and is tested on the host, without Airflow",
        "Each state is one module: adding a state is one file and one line"
      ]
    },
